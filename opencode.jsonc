{
  "$schema": "https://opencode.ai/config.json",

  // Кодер (primary). Перенесено из Stratosphere2.
  // Go-тир: ~1350 запросов на 5-часовое окно. Месячный кап ≈ 5 окон.
  "model": "opencode-go/kimi-k2.7-code"

  // Ревьювер №1 — отдельный файл .opencode/agents/reviewer.md с ЯВНОЙ моделью
  // opencode-go/deepseek-v4-pro. Явно — из-за противоречивых баг-репортов
  // про наследование модели субагентом. После первого прогона проверить
  // `opencode stats --models`, по какой модели реально списалось.
  // Ревьюверы №2 (ChatGPT) и №3 (Claude) работают вне OpenCode, по файлам.

  // ── Запасные для ревьювера, если DeepSeek V4 Pro начнёт жать ──
  // "opencode-go/deepseek-v4.1-flash" — ~26000 запросов за окно.
  // "opencode-go/mimo-v2.5"           — ~30100 запросов за окно.
  // "opencode-go/union-alpha"         — бесплатно, stealth, провайдер логирует всё.

  // ── Резерв на сложное, вызывать руками ──
  // "opencode-go/gpt-5.6-luna"   — разбор архитектуры.
  // "opencode-go/glm-5.3"        — дорогая, только на катастрофу.
  // "opencode-go/kimi-k3"        — ~110 за окно, не для рутины.

  // Точные ID сверять через /models в TUI — список ротируется.
}
